# Objetivos que el escáner tiene permitido analizar.
# IPs o rangos CIDR separados por comas (no hostnames: se autoriza la IP resuelta).
# Si la variable no existe se usa 127.0.0.1; si está vacía se bloquea todo.
# Ejemplo: SCAN_ALLOWED_HOSTS=127.0.0.1,172.17.0.0/16
SCAN_ALLOWED_HOSTS=127.0.0.1

# --- Análisis con IA (src/analyzer.py, flag --analyze) ---
# Proveedor: "ollama" (local, por defecto) o "anthropic" (API externa).
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5-coder:7b
# Si no es loopback, los datos del escaneo saldrán de la máquina (se muestra un aviso).
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Tiempo máximo de espera de la respuesta del LLM, en segundos.
LLM_TIMEOUT=120
# Solo si LLM_PROVIDER=anthropic. Pon la clave en tu .env (ignorado por git), nunca aquí.
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
